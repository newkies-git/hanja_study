# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env
# Vercel 배포용: admin 웹은 Vite 클라이언트 설정만 포함(비밀 서버 키 넣지 말 것)
!admin/frontend/.env
*.egg-info/
.pytest_cache/

# Flutter (앱·패키지 생성 후 하위에 생기는 산출물)
flutter/**/.dart_tool/
flutter/**/build/
flutter/**/.flutter-plugins-dependencies
flutter/**/*.iml

# Firebase 서비스 계정 키 (절대 커밋하지 말 것)
**/serviceAccount*.json
**/*-adminsdk-*.json

# Firebase CLI 로컬 캐시 (admin/firestore 등에서 deploy 시)
.firebase/

# OS / editor
.DS_Store

# Admin frontend (Vite)
admin/frontend/node_modules/
admin/frontend/dist/
admin/frontend/*.tsbuildinfo
