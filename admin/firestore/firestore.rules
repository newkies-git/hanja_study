rules_version = '2';

// Firebase projectId: chusa-1817
//
// - 앱(Flutter): 익명 로그인 포함, 인증 사용자 읽기 허용
// - admin(웹): Firebase Auth 로그인 사용자 중 "admin 커스텀 클레임"이 true인 경우에만 쓰기 허용
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // JWT에서 boolean 외에 문자열 등으로 들어오는 경우를 허용(클라이언트·규칙 판별을 맞춤)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.admin == 'true' ||
        request.auth.token.admin == 1
      );
    }

    // 앱·업로드 스크립트는 config/content 만 사용. 다른 문서가 필요하면 match 추가.
    match /config/content {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 기준 한자 마스터(관리 웹 CSV). 권장 문서 ID: 한자 첫 글자 코드포인트를 H+대문자16진(예: H4E00). 업로드 시 자동 정규화.
    match /hanja_basis/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ETL 산출물 컬렉션 (hanja_basis -> hanja_extend)
    match /hanja_extend/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ETL 산출물: 획/단어(최상위 컬렉션 분리)
    match /hanja_stroke/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /hanja_word/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
