rules_version = '2';

// Firebase projectId: chusa-1817
//
// - 앱(Flutter): 익명 로그인 포함, 인증 사용자 읽기 허용
// - admin(웹): Firebase Auth 로그인 사용자 중 "admin 커스텀 클레임"이 true인 경우에만 쓰기 허용
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // JWT에서 boolean 외에 문자열 등으로 들어오는 경우를 허용(클라이언트·규칙 판별을 맞춤)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.admin == 'true' ||
        request.auth.token.admin == 1
      );
    }

    // 단일 문서: (1) 원격 콘텐츠/데이터 버전·증분 동기에 필요한 메타
    // (2) 로컬 chusa.sync_sessions 에 대응하는 활성 채번·설명 등(클라이언트가 동일 스키마로 유지)
    match /config/content {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 앱·관리 웹이 클라이언트로 읽는 데이터 버전(변경분 다운로드 기준). Admin SDK는 규칙 우회.
    match /_meta/data_version {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 관리 웹 workbench: 데이터 버전 발행 시 변경 이력(문서 id 자동)
    match /_changelog/{entryId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // 기준 한자: 마스터 필드 + ETL·확장 필드(grade·etl 등)를 한 문서로 확장해 둔다. 문서 id = 로컬 hanja.id 권장(H+16진).
    match /hanja_basis/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 레거시·마이그레이션: 동일 docId 내용은 hanja_basis 확장 필드 + 로컬 hanja.origin_note(JSON) 로 통합 운영한다.
    match /hanja_extend/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ETL 산출물: 획/단어(최상위 컬렉션 분리)
    match /hanja_stroke/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /hanja_word/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
