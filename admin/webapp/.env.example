# ── 앱 ─────────────────────────────────────────────────────────
# 선택: 푸터 저작권에 표시할 이름·법인명 (비우면 "HANJA Admin")
# VITE_APP_COPYRIGHT_HOLDER=

# ── 로컬 SQLite API (admin/frontend/server.js + chusa.db) ─────
# 로컬 DB 관리·DB 동기화·채번(sync_sessions)에 사용.
# 변수를 비우면: `vite` 개발 서버에서는 켜짐, `vite build` 결과물에서는 꺼짐.
# Vercel 등에서는 false 로 두거나(또는 변수 생략 후 빌드) 정적 호스트만 쓰면 됨.
VITE_USE_LOCAL_API=true
# 프론트와 API 호스트가 다를 때만 설정 (비우면 같은 오리진의 /api — Vite 프록시 사용)
# 서버는 기본 127.0.0.1 바인딩 + Firebase ID 토큰(admin 클레임) 필수.
# VITE_LOCAL_API_BASE_URL=http://127.0.0.1:3000
#
# server.js 실행 시(선택):
#   CHUSA_API_HOST=127.0.0.1
#   CHUSA_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
#   FIREBASE_PROJECT_ID=chusa-1817

# ── Firebase 웹 앱 ────────────────────────────────────────────
# 콘솔 → 프로젝트 설정 → 일반 → 내 앱 (웹)
# 미설정 시 로그인·Firestore 호출이 동작하지 않습니다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=chusa-1817
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_APP_CHECK_KEY=

# ── 권한 ───────────────────────────────────────────────────────
# Firestore 쓰기(업로드·편집)는 Firebase Auth 사용자에
# 커스텀 클레임 admin: true (또는 문자열 "true")가 필요합니다.
# 부여: Firebase Console → Authentication → 사용자 → 커스텀 클레임,
# 또는 Admin SDK setCustomUserClaims.
# 부여 후 관리 웹에서 설정 → 인증 → 토큰 갱신.
